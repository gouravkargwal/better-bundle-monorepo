{
  "title": "Logs Explorer",
  "description": "Log volume and errors across every service",
  "tabs": [
    {
      "tabId": "default",
      "name": "Default",
      "panels": [
        {
          "id": "panel_1",
          "type": "line",
          "title": "Log Volume by Service",
          "description": "Sampling-corrected: each record counts as 1/log_sample_rate, so this is real volume, not shipped volume",
          "config": {
            "show_legends": true,
            "legends_position": null,
            "base_map": null,
            "map_view": null
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) as x_axis_1, SUM(1.0 / COALESCE(log_sample_rate, 1.0)) as y_axis_1 FROM \"default\" GROUP BY x_axis_1 ORDER BY x_axis_1",
              "vrlFunctionQuery": null,
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Timestamp",
                    "alias": "x_axis_1",
                    "column": "_timestamp",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Log lines (est.)",
                    "alias": "y_axis_1",
                    "column": "value",
                    "color": null
                  }
                ],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 24,
            "h": 14,
            "i": 1
          }
        },
        {
          "id": "panel_2",
          "type": "bar",
          "title": "Errors by Service",
          "description": "severity ERROR or above",
          "config": {
            "show_legends": true,
            "legends_position": null,
            "base_map": null,
            "map_view": null
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT service_name as x_axis_1, count(*) as y_axis_1 FROM \"default\" WHERE severity IN ('ERROR','FATAL','CRITICAL') GROUP BY x_axis_1 ORDER BY y_axis_1 DESC",
              "vrlFunctionQuery": null,
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Service",
                    "alias": "x_axis_1",
                    "column": "service_name",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Errors",
                    "alias": "y_axis_1",
                    "column": "value",
                    "color": null
                  }
                ],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 14,
            "w": 12,
            "h": 14,
            "i": 2
          }
        },
        {
          "id": "panel_3",
          "type": "donut",
          "title": "Volume by Severity",
          "description": "Sampling-corrected. Without the correction ERROR looks disproportionately common, because only INFO is sampled",
          "config": {
            "show_legends": true,
            "legends_position": null,
            "base_map": null,
            "map_view": null
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT severity as x_axis_1, SUM(1.0 / COALESCE(log_sample_rate, 1.0)) as y_axis_1 FROM \"default\" GROUP BY x_axis_1 ORDER BY y_axis_1 DESC",
              "vrlFunctionQuery": null,
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Severity",
                    "alias": "x_axis_1",
                    "column": "severity",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Log lines (est.)",
                    "alias": "y_axis_1",
                    "column": "value",
                    "color": null
                  }
                ],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 12,
            "y": 14,
            "w": 12,
            "h": 14,
            "i": 3
          }
        }
      ]
    }
  ]
}
