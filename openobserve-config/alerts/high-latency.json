{
  "name": "High-Request-Latency",
  "stream_type": "metrics",
  "stream_name": "http_server_request_duration_max",
  "is_real_time": false,
  "enabled": true,
  "description": "Max request duration above 2s over 5 minutes",
  "query_condition": {
    "type": "sql",
    "sql": "SELECT max(value) AS max_duration FROM \"http_server_request_duration_max\" WHERE service_name = 'python-worker'",
    "aggregation": {
      "group_by": [],
      "function": "max",
      "having": {
        "column": "max_duration",
        "operator": ">=",
        "value": 2.0
      }
    }
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "silence": 30
  },
  "destinations": [
    "slack"
  ]
}
