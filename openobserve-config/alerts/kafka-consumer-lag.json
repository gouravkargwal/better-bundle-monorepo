{
  "name": "Kafka-Consumption-Stalled",
  "stream_type": "metrics",
  "stream_name": "messaging_client_consumed_messages",
  "is_real_time": false,
  "enabled": true,
  "description": "No Kafka messages consumed in 15 minutes",
  "query_condition": {
    "type": "sql",
    "sql": "SELECT SUM(value) AS consumed FROM \"messaging_client_consumed_messages\"",
    "aggregation": {
      "group_by": [],
      "function": "sum",
      "having": {
        "column": "consumed",
        "operator": "<",
        "value": 1
      }
    }
  },
  "trigger_condition": {
    "period": 15,
    "operator": ">=",
    "threshold": 1,
    "frequency": 15,
    "silence": 60
  },
  "destinations": [
    "slack"
  ]
}
