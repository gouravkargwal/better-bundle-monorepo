{
  "name": "High-HTTP-Error-Rate",
  "stream_type": "metrics",
  "stream_name": "http_server_request_duration_count",
  "is_real_time": false,
  "enabled": true,
  "description": "5xx responses exceeded 10 in the last 5 minutes",
  "query_condition": {
    "type": "sql",
    "sql": "SELECT SUM(value) AS error_count FROM \"http_server_request_duration_count\" WHERE http_response_status_code >= 500",
    "aggregation": {
      "group_by": [],
      "function": "sum",
      "having": {
        "column": "error_count",
        "operator": ">=",
        "value": 10
      }
    }
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "silence": 30
  },
  "destinations": [
    "slack"
  ]
}
