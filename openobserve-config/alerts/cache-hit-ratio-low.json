{
  "name": "Cache-Hit-Ratio-Low",
  "stream_type": "metrics",
  "stream_name": "betterbundle_cache_hits",
  "is_real_time": false,
  "enabled": true,
  "description": "Cache hits fell below 100 in 15 minutes, suggesting the cache is cold or bypassed",
  "query_condition": {
    "type": "sql",
    "sql": "SELECT SUM(value) AS hits FROM \"betterbundle_cache_hits\"",
    "aggregation": {
      "group_by": [],
      "function": "sum",
      "having": {
        "column": "hits",
        "operator": "<",
        "value": 100
      }
    }
  },
  "trigger_condition": {
    "period": 15,
    "operator": ">=",
    "threshold": 1,
    "frequency": 15,
    "silence": 60
  },
  "destinations": [
    "slack"
  ]
}
