{% comment %}
  Base recommendation snippet with all common functionality
  Usage: {% render 'recommendation-base', context: 'product_page', product_id: product.id %}
{% endcomment %}

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script src="{{ 'pino-browser.js' | asset_url }}" defer></script>

<script>
  {% comment %}
    `| json`, not `| default: true`. Liquid's `default` filter treats false as
    blank, so a merchant who unticked any of these checkboxes still got `true`
    here — the settings were one-way. A checkbox setting is always a real
    boolean once the block exists, so json is both correct and honest.
  {% endcomment %}
  window.enableAutoplay = {{ block.settings.enable_autoplay | json }};
  window.autoplayDelay = {{ block.settings.autoplay_delay | default: 2.5 | times: 1000 }};
  window.showArrows = {{ block.settings.show_arrows | json }};
  window.showPagination = {{ block.settings.show_pagination | json }};
  window.recommendationLimit = {{ block.settings.limit | default: 6 }};
  window.designMode = {{ request.design_mode | json }};
  // design_mode is the theme customiser; visual_preview_mode is a shareable
  // theme preview link. Neither is a shopper, so neither should record an
  // impression — but only design_mode renders dummy data instead of fetching,
  // so preview links need the flag sent to the API.
  window.previewMode = {{ request.design_mode | json }} || {{ request.visual_preview_mode | json }};
  // Read by theme-adapt.js. When false it publishes no CSS variables, so every
  // `var(--bb-..., fallback)` in recommendation-styles falls through to the
  // merchant's own block settings.
  window.themeAdapt = {{ block.settings.theme_adapt | json }};
  window.shopDomain = {{ shop.permanent_domain | json }};
  window.customerId = {{ customer.id | json }};
  window.cartProductIds = {{ cart.items | map: 'product_id' | json }};
  // The caller passes the context; there is only one block and one context.
  window.context = '{{ context }}';

  // Passed by the block, which only renders when a product is in scope.
  window.productId = {{ product_id | json }};

  // Session id from cart attributes.
  //
  // No longer used for attribution — that travels on the cart line item now.
  // It is still sent with the recommendation request because HoldoutService
  // hashes it to assign the control/treatment bucket, and an anonymous shopper
  // must stay in the same bucket across page loads or the incrementality
  // measurement is meaningless. Do not remove.
  {% assign session_id = null %}
  {% for attribute in cart.attributes %}
    {% if attribute.first == 'bb_recommendation_session_id' %}
      {% assign session_id = attribute.last %}
      {% break %}
    {% endif %}
  {% endfor %}
  window.sessionId = {{ session_id | json }};
</script>

<!-- Load our custom JavaScript files in correct order -->
<script src="{{ 'config.js' | asset_url }}" defer></script>
{% comment %}
  First of the modules, deliberately: it publishes the CSS variables the whole
  stylesheet reads. Deferred scripts run in document order after parsing, so the
  variables are set before any card is rendered. The inline skeleton paints one
  frame ahead of it, which is why the skeleton's own greys are derived from the
  theme text colour rather than sniffed — nothing visible changes when this lands.
{% endcomment %}
<script src="{{ 'theme-adapt.js' | asset_url }}" defer></script>
<script src="{{ 'visitor-id.js' | asset_url }}" defer></script>
<script src="{{ 'attribution.js' | asset_url }}" defer></script>
<!-- JWT Authentication (load synchronously before others) -->
{% comment %}
  defer, like every other script here. It was parser-blocking, which theme
  check flags as ParserBlockingScript and which app review will pick up.

  Safe because its only consumer is main.js — the last script in this list —
  and deferred scripts execute in document order, so the dependency still
  resolves. Nothing inline uses window.JWTTokenManager.
{% endcomment %}
<script src="{{ 'jwtTokenManager.js' | asset_url }}" defer></script>
<script src="{{ 'api.js' | asset_url }}" defer></script>
<!-- Core modules (load in order) -->
<script src="{{ 'variant-manager.js' | asset_url }}" defer></script>
<script src="{{ 'dropdown-manager.js' | asset_url }}" defer></script>
<script src="{{ 'swiper-manager.js' | asset_url }}" defer></script>
<script src="{{ 'product-card-renderer.js' | asset_url }}" defer></script>
<script src="{{ 'product-image-gallery.js' | asset_url }}" defer></script>
<!-- Main product cards manager -->
<script src="{{ 'product-cards.js' | asset_url }}" defer></script>
<script src="{{ 'main.js' | asset_url }}" defer></script>

{% render 'recommendation-styles' %}

<div class="container better-bundle-recommendations">
  {% if block.settings.show_heading and block.settings.heading != blank %}
    <div class="section-heading">
      <{{ block.settings.heading_size | default: 'h2' }}>
        {{- block.settings.heading -}}
      </{{ block.settings.heading_size | default: 'h2' }}>
    </div>
  {% endif %}
  <div class="swiper">
    <div class="swiper-wrapper">
      {% render 'recommendation-products', context: context, dummy_data: dummy_data %}
    </div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-pagination"></div>
  </div>
</div>
