{% comment %}
  Optimal Product Page Recommendations - Smart Single Widget
  Backend intelligently chooses the best recommendation type based on data availability
{% endcomment %}

{% assign dummy_data = 'Messenger Bag,V-Neck Tee,Deluxe Gift Box,Trail Boots,Jogger Pants,Bucket Hat|44.99,22.99,54.99,99.99,44.99,24.99|2c3e50,27ae60,e67e22,8e44ad,1abc9c,f39c12|unused|1,1,1,1,1,1'
  | split: '|'
%}

{% comment %}
  Product page only.

  Recommendations are keyed on the product being viewed, so this block needs a
  product in scope. Placed on any other template there is nothing to recommend
  against, and the backend has no surface registered for those contexts — so it
  renders nothing rather than firing a request that would be rejected.
{% endcomment %}

{% if product and product.id %}
  {% render 'recommendation-base', context: 'product_page', product_id: product.id, dummy_data: dummy_data %}
{% endif %}

{% schema %}
{
  "name": "Product",
  "target": "section",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Section Heading" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You might also like"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "color", "id": "heading_color", "label": "Heading Color" },
    { "type": "checkbox", "id": "show_heading", "label": "Show Heading", "default": true },

    { "type": "header", "content": "Recommendations" },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of Products",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 6
    },

    { "type": "header", "content": "Card Styles" },
    { "type": "paragraph", "content": "Leave colours empty to inherit your theme's own colours and fonts. Set one only where you want to override." },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Border Radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 8
    },
    { "type": "color", "id": "card_bg", "label": "Card Background" },
    { "type": "color", "id": "title_color", "label": "Title Color" },
    { "type": "color", "id": "price_color", "label": "Price Color" },
    { "type": "color", "id": "button_bg", "label": "Button Background" },
    { "type": "color", "id": "button_text", "label": "Button Text Color" },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button Border Radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 6
    },

    { "type": "header", "content": "Controls" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show Arrows", "default": true },
    { "type": "checkbox", "id": "show_pagination", "label": "Show Pagination", "default": true },
    { "type": "color", "id": "pagination_color", "label": "Pagination Color" },
    { "type": "checkbox", "id": "enable_autoplay", "label": "Enable Autoplay", "default": true },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay Delay (seconds)",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "default": 2.5,
      "unit": "s"
    }
  ]
}
{% endschema %}
