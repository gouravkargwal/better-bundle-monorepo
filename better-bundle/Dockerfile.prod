# Two stages, because image layers are additive: the old single-stage build
# ran `npm remove @shopify/cli` and `npm prune --omit=dev` *after* the layers
# that installed them, so those commands shrank the image by exactly zero. The
# full dev tree (vite, typescript, vitest, the Shopify CLI) stayed in the
# history forever. Only what the runtime stage COPYs ships now.

# ---------- build ----------
FROM node:22-alpine AS build

# openssl: prisma generate needs it to pick a query-engine binary target.
RUN apk add --no-cache openssl

WORKDIR /app

COPY package.json package-lock.json* ./

# --workspaces=false: extensions/* are Shopify-deployed bundles, not inputs to
# the Remix server build. Installing them pulls ~19MB of node_modules the
# server never imports, and their package.json files are not copied yet.
# npm ci, not `rm -rf package-lock.json && npm install`: deleting the lockfile
# that was just copied throws away reproducibility and re-resolves the whole
# tree from the registry on every build.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --workspaces=false --include-workspace-root

COPY prisma ./prisma

# Use the local binary to avoid npx's registry re-resolution on every build.
RUN ./node_modules/.bin/prisma generate

COPY . .

# Cache Vite's incremental build artifacts across runs so rebuilds are fast
# even when source files above invalidate this layer.
RUN --mount=type=cache,target=/app/node_modules/.vite \
    npm run build

# Strip devDependencies in-place. The runtime stage copies this pruned tree
# instead of resolving the full dependency graph again.
RUN npm prune --omit=dev

# ---------- runtime ----------
FROM node:22-alpine

# openssl for the prisma query engine, curl for the healthcheck below.
RUN apk add --no-cache openssl curl

WORKDIR /app

ENV NODE_ENV=production

COPY package.json package-lock.json* ./

# Copy the pruned node_modules from the build stage instead of running a
# second npm ci. This saves an entire install cycle and guarantees the
# runtime tree matches exactly what was built.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/build ./build
COPY --from=build /app/public ./public
COPY --from=build /app/prisma ./prisma

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# `npm run start` directly, not `docker-start` — prisma generate already ran
# in the build stage.
CMD ["npm", "run", "start"]
