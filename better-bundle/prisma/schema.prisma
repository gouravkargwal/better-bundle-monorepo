  created_at                DateTime?        @db.Timestamptz(6)
  updated_at                DateTime?        @db.Timestamptz(6)
  id                        String           @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  shop_id                   String           @db.VarChar
