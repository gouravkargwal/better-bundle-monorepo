  @@index([session_id], map: "ix_offer_impressions_session_id")
  @@index([shop_id], map: "ix_offer_impressions_shop_id")
  @@index([shop_id, is_control, created_at], map: "ix_oi_control")
  @@index([shop_id, surface, created_at], map: "ix_oi_funnel")
  @@index([impression_group_id], map: "ix_oi_impression_group")
  @@index([shop_id, offer_id, outcome], map: "ix_oi_offers")
  @@index([shop_id, created_at], map: "ix_oi_shop_date")
}

