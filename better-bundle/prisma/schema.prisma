model product_edges {
  shop_id           String   @db.VarChar
  source_product_id String   @db.VarChar
  target_product_id String   @db.VarChar
  edge_type         String   @db.VarChar(20)
  prior_score       Float
  observed_count    Int
  observed_llr      Float
  blended_score     Float
  prior_reason      String?  @db.VarChar(500)
  created_at        DateTime @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamptz(6)
  updated_at        DateTime @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamptz(6)

  @@id([shop_id, source_product_id, target_product_id, edge_type], map: "pk_product_edges")
  @@index([shop_id, source_product_id, edge_type, blended_score], map: "ix_product_edges_serve")
  @@index([shop_id, target_product_id, edge_type], map: "ix_product_edges_target")
}

model product_vectors {
  product_id    String                @db.VarChar
  vector        Unsupported("vector")
  text_hash     String                @db.VarChar(32)
  model_version String                @db.VarChar
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  created_at    DateTime              @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamptz(6)
  updated_at    DateTime              @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamptz(6)
  shop_id       String                @db.VarChar
  shops         shops                 @relation(fields: [shop_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([shop_id, product_id], map: "uq_product_vector_shop_product")
  @@index([vector], map: "idx_product_vectors_vector")
  @@index([product_id], map: "ix_product_vectors_product_id")
  @@index([shop_id], map: "ix_product_vectors_shop_id")
}

