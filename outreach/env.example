# Outreach app environment template.
# Copy to outreach/.env.dev (gitignored) and fill in. See root .gitignore.

# Elastic Email REST API key. Get it at elasticemail.com -> Settings -> API.
# Used for BOTH sending (POST /emails/transactional) and event tracking
# (GET /events, matched by the MessageID the send returns).
# The legacy alias ELASTICMAILPASS is still read as a fallback.
ELASTIC_EMAIL_API_KEY=your_elastic_email_api_key_here

# Gmail credentials used ONLY for polling replies (IMAP). Outreach is sent via
# Elastic Email, not Gmail SMTP. Get an app password at myaccount.google.com.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASS=your_16_char_app_password

# Gemini (copywriting + classification). Google AI Studio key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Sender identity. Must be a VERIFIED sender on your Elastic Email account.
SENDER_EMAIL=founder@yourdomain.com
SENDER_NAME=Your Name | Your Brand

# Warmup throttle.
DAILY_SEND_CAP=15
