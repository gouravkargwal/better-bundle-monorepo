FROM python:3.11-slim

WORKDIR /app

# Never build a package from source when a wheel exists. Without this pip will
# happily spend minutes compiling something it could have downloaded.
ENV PIP_PREFER_BINARY=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Only curl, for the healthcheck below. gcc/g++ were ~200MB to compile nothing:
# a build of these exact pins resolved every package to a manylinux wheel, with
# zero "Building wheel for ..." lines. They were kept against the possibility of
# a wheel-less package, but that possibility costs 200MB on every rebuild and
# announces itself loudly when it happens -- add them back at that point.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Requirements are copied on their own so this layer caches. Editing app code
# does not reinstall dependencies; only a requirements change does.
COPY requirements.txt requirements-dev.txt ./

# --timeout/--retries because grpcio and the google-cloud-aiplatform tree are
# large wheels, and pip's 15s default read timeout aborts the whole install if
# the CDN stalls mid-download.
# requirements-dev.txt, which pulls in requirements.txt: the dev container
# bind-mounts the repo and runs the test suite, so it needs pytest. The prod
# image installs requirements.txt alone.
RUN pip install --no-cache-dir --timeout 120 --retries 5 -r requirements-dev.txt

COPY . .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# --proxy-headers: without it uvicorn cannot see the original scheme behind a
# tunnel or load balancer, so any redirect it emits (a trailing-slash 307, for
# one) points at http://. Browsers block that as mixed content on an https
# storefront, and the request silently never happens.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--proxy-headers", "--forwarded-allow-ips", "*"]
