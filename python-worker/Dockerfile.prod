FROM python:3.11-slim

# Never compile a package that ships a wheel.
ENV PIP_PREFER_BINARY=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies (production only)
# CPU-only PyTorch. The default sentence-transformers dependency chain pulls
# the CUDA build — over a gigabyte of libraries no container here can use.
RUN pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        -r requirements.txt

# Copy application code
COPY . .

# Remove development dependencies and cache
RUN pip cache purge && \
    find /usr/local/lib/python3.11/site-packages -name "*.pyc" -delete && \
    find /usr/local/lib/python3.11/site-packages -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application in production mode.
#
# --workers 1, deliberately, and it is a correctness fix rather than a tuning one.
#
# `uvicorn --workers N` forks N complete copies of the app, each running the
# whole lifespan in app/main.py — which starts the enrichment sweeper, the
# attribution reconciler, the FX refresher and the ingestion backstop with no
# guard against being run more than once. At --workers 4 that is four ingestion
# backstops asking Shopify for every shop's orders every 30 minutes, four
# reconcilers sweeping the same rows, and four refreshers hitting the FX API.
# Four workers each find the same missing order and each republish it.
#
# It has never been seen because dev runs `--reload`, which is a single worker.
#
# The throughput cost is small: serving is CPU-bound in Python at ~15 req/s per
# core (measured), so a second worker inside the 1.25-core cap buys roughly 20%.
# The real win is the cache placement, which is worth 5-10x and makes this
# question moot.
#
# To go back to multiple workers, the background tasks need to elect a single
# runner first — a Postgres advisory lock in the lifespan is the natural fit,
# since only one worker can hold it and it releases itself if that worker dies.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
